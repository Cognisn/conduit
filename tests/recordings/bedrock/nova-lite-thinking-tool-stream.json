          }
        },
        {
          "contentBlockDelta": {
            "contentBlockIndex": 2,
            "delta": {
              "text": "</thinking>"
            }
          }
        },
        {
          "contentBlockStop": {
            "contentBlockIndex": 2
          }
        },
        {
          "contentBlockStart": {
            "contentBlockIndex": 3,
            "start": {
              "toolUse": {
                "name": "lookup_host",
                "toolUseId": "tooluse_example0002"
